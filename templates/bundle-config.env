# Example environment file for internal pipeline templates.
# Adjust these values in the isolated AD build platform.
export AD_BUILD_WORK_DIR=${AD_BUILD_WORK_DIR:-/root/AD}
export AD_BUILD_BUNDLE_PROFILE=${AD_BUILD_BUNDLE_PROFILE:-full}
export AD_BUILD_BUNDLE_OUT=${AD_BUILD_BUNDLE_OUT:-ad-build-compiled-state.tar}
